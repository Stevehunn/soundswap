<Window x:Class="SoundSwap.Desktop.Views.ConfigEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SoundSwap.Desktop.Localization"
        xmlns:ctl="clr-namespace:SoundSwap.Desktop.Controls"
        Title="{Binding Title}" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="14"
        FlowDirection="{Binding FlowDirection, Source={x:Static loc:Localizer.Instance}}">
  <Window.Triggers>
    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
      <BeginStoryboard><Storyboard>
        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
      </Storyboard></BeginStoryboard>
    </EventTrigger>
  </Window.Triggers>
  <StackPanel x:Name="Root" Margin="28">
    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,18"/>

    <TextBlock Text="{loc:Loc name}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

    <TextBlock Text="{loc:Loc output_device}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
    <ComboBox ItemsSource="{Binding Outputs}" SelectedItem="{Binding SelectedOutput}" ItemTemplate="{StaticResource DeviceTemplate}" Margin="0,0,0,14"/>

    <TextBlock Text="{loc:Loc input_device}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
    <ComboBox ItemsSource="{Binding Inputs}" SelectedItem="{Binding SelectedInput}" ItemTemplate="{StaticResource DeviceTemplate}" Margin="0,0,0,14"/>

    <TextBlock Text="{loc:Loc shortcut}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
    <ctl:HotkeyField Value="{Binding Hotkey, Mode=TwoWay}" Margin="0,0,0,14"/>

    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,12"
               Visibility="{Binding HasError, Converter={StaticResource B2V}}"/>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="{loc:Loc cancel}" IsCancel="True" Margin="0,0,12,0"/>
      <Button Style="{StaticResource AccentButton}" Content="{loc:Loc validate}" IsDefault="True" Click="OnValidate"/>
    </StackPanel>
  </StackPanel>
</Window>
