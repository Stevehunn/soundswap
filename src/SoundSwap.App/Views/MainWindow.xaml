<Window x:Class="SoundSwap.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SoundSwap.Desktop.Localization"
        xmlns:ctl="clr-namespace:SoundSwap.Desktop.Controls"
        Title="SoundSwap" Width="880" Height="620" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/SoundSwap.ico"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="14"
        FlowDirection="{Binding FlowDirection, Source={x:Static loc:Localizer.Instance}}">
  <Window.Triggers>
    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
      <BeginStoryboard><Storyboard>
        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25"/>
      </Storyboard></BeginStoryboard>
    </EventTrigger>
  </Window.Triggers>
  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header: logo, language, theme -->
    <Border Grid.Row="0" Padding="20,10" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="pack://application:,,,/Assets/logo-64.png" Width="28" Height="28"/>
          <TextBlock Text="SoundSwap" Margin="10,0,0,0" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <!-- Appears only when a newer GitHub release exists; click = download, click again = install -->
          <Button Style="{StaticResource AccentButton}" Margin="0,0,12,0" Command="{Binding Update.PrimaryActionCommand}"
                  Content="{Binding Update.ButtonText}" IsEnabled="{Binding Update.IsButtonEnabled}"
                  Visibility="{Binding Update.IsButtonVisible, Converter={StaticResource B2V}}"/>
          <ComboBox Width="160" Margin="0,0,8,0" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                    ItemTemplate="{StaticResource LanguageTemplate}" ToolTip="{loc:Loc language}"/>
          <ComboBox Width="130" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}" ToolTip="{loc:Loc theme}">
            <ComboBox.ItemTemplate>
              <DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Content="{loc:Loc customize}" Margin="8,0,0,0" Command="{Binding CustomizeThemeCommand}"
                  Visibility="{Binding IsCustomTheme, Converter={StaticResource B2V}}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Title + new -->
    <Grid Grid.Row="1" Margin="32,24,32,16">
      <TextBlock Text="{loc:Loc configurations}" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <Button Style="{StaticResource AccentButton}" HorizontalAlignment="Right" Content="{loc:Loc new_config}" Command="{Binding NewConfigCommand}"/>
    </Grid>

    <!-- Next-configuration shortcut -->
    <Border Grid.Row="2" Margin="32,0,32,16" Padding="14,8" CornerRadius="10" BorderThickness="1"
            BorderBrush="{DynamicResource LineBrush}" Background="{DynamicResource InputBrush}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{loc:Loc next_hint}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <ctl:HotkeyField Width="260" Value="{Binding NextHotkey, Mode=TwoWay}"/>
        <TextBlock Text="{loc:Loc hotkey_conflict}" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" Margin="12,0,0,0"
                   Visibility="{Binding NextHotkeyError, Converter={StaticResource B2V}}"/>
      </StackPanel>
    </Border>

    <!-- List (cards can be dragged to reorder: see MainWindow.DragDrop.cs) -->
    <Grid Grid.Row="3">
      <TextBlock Text="{loc:Loc empty_list}" Margin="32,8" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"
                 Visibility="{Binding IsEmpty, Converter={StaticResource B2V}}"/>
      <ScrollViewer x:Name="ListScroll" VerticalScrollBarVisibility="Auto" AllowDrop="True"
                    DragOver="OnListDragOver" Drop="OnListDrop">
        <ItemsControl x:Name="ItemsList" ItemsSource="{Binding Items}" Margin="32,8,32,8" AllowDrop="True"
                      PreviewMouseLeftButtonDown="OnListMouseDown" PreviewMouseMove="OnListMouseMove">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Border Margin="0,0,0,10" Padding="14,14,18,14" CornerRadius="12" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
                  <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                  <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Color="Black" Opacity="0"/></Border.Effect>
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
                      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                          <Setter Property="Background" Value="{DynamicResource ActivePanelBrush}"/>
                          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsDragging}" Value="True">
                          <Setter Property="Opacity" Value="0.4"/>
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Trigger.EnterActions><BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-2" Duration="0:0:0.15"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0.28" Duration="0:0:0.15"/>
                          </Storyboard></BeginStoryboard></Trigger.EnterActions>
                          <Trigger.ExitActions><BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.2"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0" Duration="0:0:0.2"/>
                          </Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                          <BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" Duration="0:0:0.3" FillBehavior="Stop"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="14" Duration="0:0:0.3" FillBehavior="Stop">
                              <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                          </Storyboard></BeginStoryboard>
                        </EventTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Grip: hints that the card can be dragged -->
                    <Path Grid.Column="0" Fill="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,14,0"
                          Cursor="SizeAll" ToolTip="{loc:Loc drag_hint}">
                      <Path.Data>
                        <GeometryGroup>
                          <EllipseGeometry Center="2,2" RadiusX="1.6" RadiusY="1.6"/>
                          <EllipseGeometry Center="9,2" RadiusX="1.6" RadiusY="1.6"/>
                          <EllipseGeometry Center="2,9" RadiusX="1.6" RadiusY="1.6"/>
                          <EllipseGeometry Center="9,9" RadiusX="1.6" RadiusY="1.6"/>
                          <EllipseGeometry Center="2,16" RadiusX="1.6" RadiusY="1.6"/>
                          <EllipseGeometry Center="9,16" RadiusX="1.6" RadiusY="1.6"/>
                        </GeometryGroup>
                      </Path.Data>
                    </Path>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/>
                        <Border Margin="10,0,0,0" Padding="8,2" CornerRadius="10" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                                RenderTransformOrigin="0.5,0.5">
                          <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="Visibility" Value="Collapsed"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                  <Setter Property="Visibility" Value="Visible"/>
                                  <DataTrigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.6" To="1" Duration="0:0:0.2"/>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.6" To="1" Duration="0:0:0.2"/>
                                  </Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <TextBlock Text="{loc:Loc active}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentBrush}"/>
                        </Border>
                      </StackPanel>
                      <TextBlock Text="{Binding Subtitle}" Margin="0,4,0,0" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding HotkeyError}" Margin="0,4,0,0" Foreground="{DynamicResource DangerBrush}"
                                 Visibility="{Binding HasError, Converter={StaticResource B2V}}"/>
                    </StackPanel>

                    <Border Grid.Column="2" Margin="16,0" Padding="10,4" CornerRadius="6" VerticalAlignment="Center" BorderThickness="1"
                            Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource LineBrush}">
                      <TextBlock Text="{Binding ShortcutDisplay}" FontFamily="Consolas" FontSize="13"/>
                    </Border>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Style="{StaticResource AccentButton}" Margin="0,0,8,0"
                              Command="{Binding DataContext.ActivateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                        <Path Data="M0,0 L9,5.5 L0,11 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                      </Button>
                      <Button Content="{loc:Loc edit}" Margin="0,0,8,0"
                              Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                      <Button Style="{StaticResource DangerButton}" Content="{loc:Loc delete}"
                              Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                    </StackPanel>
                  </Grid>
                </Border>

                <!-- Drop indicators (insertion line above / below the card) -->
                <Border Height="3" CornerRadius="2" Background="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,-6,0,0"
                        IsHitTestVisible="False" Visibility="{Binding DropBefore, Converter={StaticResource B2V}}"/>
                <Border Height="3" CornerRadius="2" Background="{DynamicResource AccentBrush}" VerticalAlignment="Bottom" Margin="0,0,0,3"
                        IsHitTestVisible="False" Visibility="{Binding DropAfter, Converter={StaticResource B2V}}"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <!-- Footer -->
    <Border Grid.Row="4" Padding="32,12" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
      <StackPanel>
        <WrapPanel Margin="0,0,0,8">
          <CheckBox Content="{loc:Loc start_with_windows}" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" Margin="0,0,24,4"/>
          <CheckBox Content="{loc:Loc notify_on_switch}" IsChecked="{Binding NotifyOnSwitch, Mode=TwoWay}" Margin="0,0,24,4"/>
          <CheckBox Content="{loc:Loc update_auto}" IsChecked="{Binding CheckForUpdates, Mode=TwoWay}" Margin="0,0,0,4"/>
        </WrapPanel>
        <Grid>
          <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource LinkButton}" Content="{loc:Loc update_check}" Command="{Binding Update.CheckNowCommand}"/>
            <TextBlock Text="{Binding Update.StatusText}" Margin="12,0,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="13"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock Text="{loc:Loc status_running}" Foreground="{DynamicResource MutedBrush}" FontSize="13"/>
            <TextBlock Text="{Binding VersionText, StringFormat=' · {0}'}" Foreground="{DynamicResource MutedBrush}" FontSize="13"/>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</Window>
