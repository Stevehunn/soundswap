<Window x:Class="SoundSwap.Desktop.Views.CloseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SoundSwap.Desktop.Localization"
        Title="SoundSwap" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="14"
        FlowDirection="{Binding FlowDirection, Source={x:Static loc:Localizer.Instance}}">
  <Window.Triggers>
    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
      <BeginStoryboard><Storyboard>
        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
      </Storyboard></BeginStoryboard>
    </EventTrigger>
  </Window.Triggers>
  <StackPanel x:Name="Root" Margin="28">
    <TextBlock Text="{loc:Loc close_title}" FontSize="20" FontWeight="SemiBold"/>
    <TextBlock Text="{loc:Loc close_message}" Margin="0,8,0,20" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
    <Button Style="{StaticResource AccentButton}" Content="{loc:Loc close_minimize}" Margin="0,0,0,10" Click="OnMinimize" IsDefault="True"/>
    <Button Style="{StaticResource DangerButton}" Content="{loc:Loc close_quit}" Margin="0,0,0,10" Click="OnQuit"/>
    <Button Content="{loc:Loc cancel}" BorderThickness="0" Background="Transparent" IsCancel="True" Foreground="{DynamicResource MutedBrush}"/>
  </StackPanel>
</Window>
