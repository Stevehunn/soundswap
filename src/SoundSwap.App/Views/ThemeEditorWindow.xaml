<Window x:Class="SoundSwap.Desktop.Views.ThemeEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SoundSwap.Desktop.Localization"
        Title="{loc:Loc custom_theme_title}" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="Manual" ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="14"
        FlowDirection="{Binding FlowDirection, Source={x:Static loc:Localizer.Instance}}">
  <Window.Triggers>
    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
      <BeginStoryboard><Storyboard>
        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
      </Storyboard></BeginStoryboard>
    </EventTrigger>
  </Window.Triggers>
  <StackPanel x:Name="Root" Margin="28">
    <TextBlock Text="{loc:Loc custom_theme_title}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,18"/>

    <TextBlock Text="{loc:Loc presets}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
    <ItemsControl ItemsSource="{Binding Presets}" Margin="0,0,0,12">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Button Width="48" Height="48" Padding="0" Margin="0,0,10,10" ToolTip="{Binding Name}"
                  Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                  CommandParameter="{Binding}">
            <Grid>
              <Border CornerRadius="6" Margin="5" Background="{Binding Colors.Background, Converter={StaticResource HexToBrush}}"/>
              <Ellipse Width="18" Height="18" Fill="{Binding Colors.Accent, Converter={StaticResource HexToBrush}}"/>
            </Grid>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- One row per color: swatch (opens the color dialog) + hex field -->
    <Grid Margin="0,0,0,10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="{loc:Loc color_background}" VerticalAlignment="Center"/>
      <Button Grid.Column="1" Tag="Background" Click="OnPickColor" Width="48" Height="40" Padding="0" Margin="0,0,10,0">
        <Border CornerRadius="5" Margin="5" Background="{Binding BackgroundHex, Converter={StaticResource HexToBrush}}"/>
      </Button>
      <TextBox Grid.Column="2" Width="110" MaxLength="7" FontFamily="Consolas" Text="{Binding BackgroundHex, UpdateSourceTrigger=PropertyChanged}"/>
    </Grid>
    <Grid Margin="0,0,0,10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="{loc:Loc color_surface}" VerticalAlignment="Center"/>
      <Button Grid.Column="1" Tag="Surface" Click="OnPickColor" Width="48" Height="40" Padding="0" Margin="0,0,10,0">
        <Border CornerRadius="5" Margin="5" Background="{Binding SurfaceHex, Converter={StaticResource HexToBrush}}"/>
      </Button>
      <TextBox Grid.Column="2" Width="110" MaxLength="7" FontFamily="Consolas" Text="{Binding SurfaceHex, UpdateSourceTrigger=PropertyChanged}"/>
    </Grid>
    <Grid Margin="0,0,0,10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="{loc:Loc color_text}" VerticalAlignment="Center"/>
      <Button Grid.Column="1" Tag="Text" Click="OnPickColor" Width="48" Height="40" Padding="0" Margin="0,0,10,0">
        <Border CornerRadius="5" Margin="5" Background="{Binding TextHex, Converter={StaticResource HexToBrush}}"/>
      </Button>
      <TextBox Grid.Column="2" Width="110" MaxLength="7" FontFamily="Consolas" Text="{Binding TextHex, UpdateSourceTrigger=PropertyChanged}"/>
    </Grid>
    <Grid Margin="0,0,0,14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="{loc:Loc color_accent}" VerticalAlignment="Center"/>
      <Button Grid.Column="1" Tag="Accent" Click="OnPickColor" Width="48" Height="40" Padding="0" Margin="0,0,10,0">
        <Border CornerRadius="5" Margin="5" Background="{Binding AccentHex, Converter={StaticResource HexToBrush}}"/>
      </Button>
      <TextBox Grid.Column="2" Width="110" MaxLength="7" FontFamily="Consolas" Text="{Binding AccentHex, UpdateSourceTrigger=PropertyChanged}"/>
    </Grid>

    <TextBlock Text="{loc:Loc low_contrast}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,14"
               Visibility="{Binding LowContrast, Converter={StaticResource B2V}}"/>

    <Grid Margin="0,6,0,0">
      <Button Content="{loc:Loc reset}" HorizontalAlignment="Left" Command="{Binding ResetCommand}"/>
      <Button Style="{StaticResource AccentButton}" Content="{loc:Loc close}" HorizontalAlignment="Right" IsDefault="True" IsCancel="True" Click="OnClose"/>
    </Grid>
  </StackPanel>
</Window>
